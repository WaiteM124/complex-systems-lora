# Copy to .env and fill in local values. Never commit .env or real secrets.
# This file lists every setting in src/app/settings.py, with placeholders only.

# Required.
APP_ENV=local

# Optional. Defaults to INFO if unset.
LOG_LEVEL=INFO

# Optional locally. Required when APP_ENV is staging or production.
LLM_API_KEY=

# Optional Langfuse tracing. The tracer no-ops when these are absent.
# Never commit real keys; they are never logged.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

# Optional.
AWS_REGION=eu-west-2
AWS_ACCOUNT_ID=<ACCOUNT_ID>
DATABASE_URL=postgresql://user:password@localhost:5432/app
